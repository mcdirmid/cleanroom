# update_python_with_ai/BUILD.bazel

load("//update_with_ai/support/lib:update_with_ai.bzl", "define_role")

alias(
    name = "lifecycle",
    actual = "//update_python_with_ai/support/lib:lifecycle_spec",
    visibility = ["//visibility:public"],
)

define_role(
    name = "high",
    src_pattern = "{unit_dir}/high/{unit_name}.md",
    template = "//update_python_with_ai/templates:hls",
    prompt_template = "Files are aligned according to the guide.",
    guide = "//update_python_with_ai/guides:high_level_spec",
    allows_step_mode = True,
    role_deps = [],
    star_role_deps = [":high"],
    active_component_types = ["implementation", "assembly", "interface", "external"],
    verify_template = "cd $BUILD_WORKSPACE_DIRECTORY && python3 update_with_ai/support/lib/hls_lint.py {unit_dir}/high/{unit_name}.md",
    visibility = ["//visibility:public"],
)

define_role(
    name = "requirements",
    src_pattern = "{unit_dir}/requirements/{unit_name}.md",
    template = "//update_python_with_ai/templates:requirements",
    prompt_template = "Files are aligned according to the guide.",
    guide = "//update_python_with_ai/guides:high_to_requirements",
    allows_step_mode = True,
    role_deps = [":high"],
    star_role_deps = [":requirements"],
    active_component_types = ["implementation", "assembly", "interface"],
    verify_template = "cd $BUILD_WORKSPACE_DIRECTORY && python3 update_with_ai/support/lib/requirements_lint.py {unit_dir}/requirements/{unit_name}.md",
    visibility = ["//visibility:public"],
)

define_role(
    name = "grounding",
    src_pattern = "{unit_dir}/grounding/{unit_name}.pyi",
    template = "//update_python_with_ai/templates:lls",
    prompt_template = "Files are aligned according to the guide.",
    guide = "//update_python_with_ai/guides:high_to_grounding",
    allows_step_mode = True,
    role_deps = [":high", ":requirements"],
    star_role_deps = [":grounding"],
    active_component_types = ["implementation", "assembly", "interface", "external"],
    verify_template = "cd $BUILD_WORKSPACE_DIRECTORY && python3 update_with_ai/support/lib/grounding_tool.py --check {unit_dir}/grounding/{unit_name}.pyi",
    visibility = ["//visibility:public"],
)

alias(
    name = "low",
    actual = ":grounding",
    visibility = ["//visibility:public"],
)

define_role(
    name = "lib",
    src_pattern = "{unit_dir}/lib/{unit_name}.py",
    template = "//update_python_with_ai/templates:lib",
    prompt_template = "Files are aligned according to the guide.",
    guide = "//update_python_with_ai/guides:grounding_to_lib",
    allows_step_mode = True,
    star_role_deps = [":grounding"],
    silent_cross_role_deps = [":lib"],
    active_component_types = ["implementation", "assembly", "interface"],
    verify_template = "cd $BUILD_WORKSPACE_DIRECTORY && python3 update_with_ai/support/lib/lib_lint.py {unit_dir}/lib/BUILD.bazel {unit_dir}/lib/{unit_name}.py --pyi {unit_dir}/grounding/{unit_name}.pyi && bazel test //{unit_dir}/lib:{unit_name}_type_check --test_output=errors --test_timeout=100 --noshow_progress --noshow_loading_progress 2>&1",
    verification_success_message = "Verification passed: {unit_name}.py compiles correctly and passes all static checks. Call check_file often to verify edits. Note: Unit tests are executed separately by the QA agent in a later session.",
    visibility = ["//visibility:public"],
)

define_role(
    name = "test",
    src_pattern = "{unit_dir}/tests/{unit_name}_test.py",
    template = "//update_python_with_ai/templates:test",
    prompt_template = "Files are aligned according to the guide.",
    guide = "//update_python_with_ai/guides:grounding_to_test",
    allows_step_mode = True,
    star_role_deps = [":grounding"],
    silent_role_deps = [":lib"],
    silent_cross_role_deps = [":lib"],
    active_component_types = ["implementation"],
    verify_template = "cd $BUILD_WORKSPACE_DIRECTORY && python3 update_with_ai/support/lib/test_lint.py {unit_dir}/tests/BUILD.bazel {unit_dir}/tests/{unit_name}_test.py --lib-pkg {unit_dir}/lib --pyi {unit_dir}/grounding/{unit_name}.pyi && bazel test //{unit_dir}/tests:{unit_name}_test_type_check --test_output=errors --test_timeout=100 --noshow_progress --noshow_loading_progress 2>&1",
    verification_success_message = "Verification passed: {unit_name}_test.py compiles correctly and passes all static checks. Call check_file often to verify edits. Note: Unit tests are executed separately by the QA agent in a later session.",
    visibility = ["//visibility:public"],
)

define_role(
    name = "qa",
    src_pattern = "{unit_dir}/logs/{unit_name}_qa.log",
    template = "//update_python_with_ai/templates:qa",
    prompt_template = "Files are aligned according to the guide.",
    guide = "//update_python_with_ai/guides:qa",
    allows_step_mode = False,
    star_role_deps = [":grounding"],
    feedback_role_deps = [":lib", ":test"],
    active_component_types = ["implementation"],
    verify_template = "cd $BUILD_WORKSPACE_DIRECTORY && bazel test //{unit_dir}/tests:{unit_name}_test --test_output=errors --test_timeout=100 --noshow_progress --noshow_loading_progress 2>&1 && if [ -s {unit_dir}/logs/{unit_name}_qa.log ]; then echo 'QA log is not empty: delete all lines (0 bytes, remove any headers).'; exit 1; fi",
    verification_success_message = "Test {unit_name}_test.py passed.",
    visibility = ["//visibility:public"],
)

define_role(
    name = "coverage",
    src_pattern = "{unit_dir}/logs/{unit_name}_coverage.log",
    template = "//update_python_with_ai/templates:coverage",
    prompt_template = "Files are aligned according to the guide.",
    guide = "//update_python_with_ai/guides:coverage",
    allows_step_mode = False,
    silent_role_deps = [":qa"],
    star_role_deps = [":grounding"],
    feedback_role_deps = [":lib", ":test"],
    active_component_types = ["implementation"],
    verify_template = "cd $BUILD_WORKSPACE_DIRECTORY && bazel test //{unit_dir}/tests:{unit_name}_test --test_output=errors --test_timeout=100 --noshow_progress --noshow_loading_progress 2>&1 && python3 update_with_ai/support/lib/evaluate_coverage.py --impl {unit_dir}/lib/{unit_name}.py --test {unit_dir}/tests/{unit_name}_test.py --threshold 100.0 && if [ -s {unit_dir}/logs/{unit_name}_coverage.log ]; then echo 'Coverage log is not empty: delete all lines (0 bytes, remove any headers).'; exit 1; fi",
    verification_success_message = "All lines of {unit_name}.py are covered by {unit_name}_test.py.",
    visibility = ["//visibility:public"],
)

