{
  "autofab-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|write_file|edit_file|view_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 plugins/autofab/hooks/gate.py || echo '{\"decision\": \"allow\"}'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
