# Repo-wide default model configuration (a `model_config` target) for
# the generated *_clean binaries. The value is embedded into the binaries at
# build time; --config <label> (after `--`) or the MODEL_CONFIG_TARGET /
# AGENT_CONFIG_TARGET environment variable still override it per run.
#
#   bazel run //pkg:my_node_clean -- --config //model_configs:staging
#   MODEL_CONFIG_TARGET=//model_configs:staging bazel run //pkg:my_node_clean
#
# Personal default: configs tend to be personal, and the config *definitions*
# live in model_configs/BUILD.bazel. Override the default selection in your
# user-level bazelrc (~/.bazelrc), which is read AFTER this file:
#
#   echo 'build --define=MODEL_CONFIG=//model_configs:sean' >> ~/.bazelrc
#
# (Add the :sean target to //model_configs:all_configs so it is bundled into
# every *_clean binary's runfiles; otherwise build it once and it is resolved
# from bazel-bin. Command-line --define beats ~/.bazelrc beats this file.)
build --define=MODEL_CONFIG=//model_configs:qwen-moe-q6
