# Repo-wide default agent/model configuration (an `agent_config` target) for
# the generated *_clean binaries. The value is embedded into the binaries at
# build time; --config <label> (after `--`) or the AGENT_CONFIG_TARGET
# environment variable still override it per run.
#
#   bazel run //pkg:my_node_clean -- --config //agent_configs:staging
#   AGENT_CONFIG_TARGET=//agent_configs:staging bazel run //pkg:my_node_clean
#
# Personal default: configs tend to be personal, and the config *definitions*
# live in agent_configs/BUILD.bazel. Override the default selection in your
# user-level bazelrc (~/.bazelrc), which is read AFTER this file:
#
#   echo 'build --define=AGENT_CONFIG=//agent_configs:sean' >> ~/.bazelrc
#
# (Add the :sean target to //agent_configs:all_configs so it is bundled into
# every *_clean binary's runfiles; otherwise build it once and it is resolved
# from bazel-bin. Command-line --define beats ~/.bazelrc beats this file.)
build --define=AGENT_CONFIG=//agent_configs:stamsam
