# update_with_ai/BUILD.bazel

load("//update_with_ai/support/lib:update_with_ai.bzl", "batch_mark_clean")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "high_specs",
    srcs = [
        "//update_with_ai/parts/dag:high_specs",
        "//update_with_ai/parts/agent:high_specs",
        "//update_with_ai/parts/loop:high_specs",
        "//update_with_ai/parts/sandbox:high_specs",
        "//update_with_ai/parts/bazel:high_specs",
        "//update_with_ai/parts/openai:high_specs",
        "//update_with_ai/parts/core:high_specs",
        "//update_with_ai/parts/systems:high_specs",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "grounding_specs",
    srcs = [
        "//update_with_ai/parts/dag:grounding_specs",
        "//update_with_ai/parts/agent:grounding_specs",
        "//update_with_ai/parts/loop:grounding_specs",
        "//update_with_ai/parts/sandbox:grounding_specs",
        "//update_with_ai/parts/bazel:grounding_specs",
        "//update_with_ai/parts/openai:grounding_specs",
        "//update_with_ai/parts/core:grounding_specs",
        "//update_with_ai/parts/systems:grounding_specs",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "high",
    tags = ["high_lint"],
)

test_suite(
    name = "low",
    tags = ["low_lint"],
)

filegroup(
    name = "part_build_files",
    srcs = [
        "//update_with_ai/parts/agent:BUILD.bazel",
        "//update_with_ai/parts/bazel:BUILD.bazel",
        "//update_with_ai/parts/core:BUILD.bazel",
        "//update_with_ai/parts/dag:BUILD.bazel",
        "//update_with_ai/parts/loop:BUILD.bazel",
        "//update_with_ai/parts/openai:BUILD.bazel",
        "//update_with_ai/parts/sandbox:BUILD.bazel",
        "//update_with_ai/parts/systems:BUILD.bazel",
    ],
    visibility = ["//visibility:public"],
)

# ============================================================================
# Aggregate batch mark clean targets for parts packages.
# ============================================================================

# Clean all nodes across all roles in all parts packages
batch_mark_clean(
    name = "all_mark_clean",
    role = "",
    scope_dir = "update_with_ai/parts",
)

alias(
    name = "clean",
    actual = ":all_mark_clean",
)

