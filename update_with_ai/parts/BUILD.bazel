# update_with_ai/parts/BUILD.bazel
#
# Aggregate batch mark clean targets for parts packages.
# When synced to staging, these targets become //update_with_ai/parts:<role>_mark_clean.

load("//update_with_ai/support/lib:update_with_ai.bzl", "batch_mark_clean")

package(default_visibility = ["//visibility:public"])

# Clean all nodes across all roles in all parts packages
batch_mark_clean(
    name = "all_mark_clean",
    role = "",
)

alias(
    name = "clean",
    actual = ":all_mark_clean",
)

# Role-specific batch mark clean targets and aliases
batch_mark_clean(
    name = "high_mark_clean",
    role = "high",
)

alias(
    name = "all_high_mark_clean",
    actual = ":high_mark_clean",
)

