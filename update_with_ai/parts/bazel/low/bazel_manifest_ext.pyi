## Usage Snippets

### `Deserializing Unit and Role Manifests`

```python
import json
from typing import Any, Mapping

def load_unit_manifest(content: str) -> Mapping[str, Any]:
    \"\"\"Deserializes unit manifest JSON text into a typed mapping.\"\"\"
    data = json.loads(content)
    if "label" not in data or "name" not in data:
        raise ValueError("Invalid unit manifest: missing required fields 'label' or 'name'")
    return data

def load_role_manifest(content: str) -> Mapping[str, Any]:
    \"\"\"Deserializes role manifest JSON text into a typed mapping.\"\"\"
    data = json.loads(content)
    if "label" not in data or "name" not in data:
        raise ValueError("Invalid role manifest: missing required fields 'label' or 'name'")
    return data

def load_target_manifest(content: str) -> Mapping[str, Any]:
    \"\"\"Deserializes monolithic target manifest JSON text into a typed mapping.\"\"\"
    data = json.loads(content)
    if "label" not in data or "name" not in data:
        raise ValueError("Invalid target manifest: missing required fields 'label' or 'name'")
    return data
```
