def __initialize__(registry: Optional[LifecycleRegistry] = None) -> None:
    reg = get_default_registry() if registry is None else registry
    reg.register_singleton(
        NodeConfig,
        keys=[NodeConfig, agent_node_config.NodeConfig, InTier[AgentSessionTier]],
        tier=agent_session,
    )
    reg.register_singleton(
        AliasManager,
        keys=[AliasManager, agent_file_alias.AliasManager, InTier[AgentSessionTier]],
        tier=agent_session,
    )

_initialize_ = __initialize__
