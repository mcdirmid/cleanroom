def __initialize__(registry: Optional[LifecycleRegistry] = None) -> None:
    reg = get_default_registry() if registry is None else registry
    reg.register_singleton(
        AgentConfig,
        keys=[AgentConfig, agent_config.AgentConfig, InTier[SystemTier]],
        tier=system,
    )
    reg.register_singleton(
        DagConfig,
        keys=[DagConfig, dag_config.DagConfig, InTier[SystemTier]],
        tier=system,
    )
    reg.register_singleton(
        OpenAIConfig,
        keys=[OpenAIConfig, openai_config.OpenAIConfig, InTier[SystemTier]],
        tier=system,
    )

_initialize_ = __initialize__
