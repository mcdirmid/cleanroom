# update_with_ai/parts/sandbox/BUILD.bazel

load("//update_python_with_ai/support/lib:update_python_with_ai.bzl", "update_python_with_ai")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "high_specs",
    srcs = glob(["high/*.md"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "grounding_specs",
    srcs = glob(["grounding/*.pyi"]),
    visibility = ["//visibility:public"],
)

update_python_with_ai(
    name = "sandbox",
    module_deps = ['//update_with_ai/parts/agent:agent_config', ':tool_provider'],
)

update_python_with_ai(
    name = "sandbox_impl",
    module_deps = ['//update_with_ai/parts/agent:agent_config', '//update_with_ai/parts/agent:agent_node_config', ':sandbox', ':sandbox_file_editor', ':sandbox_file_reader', ':sandbox_run_control', ':tool_provider'],
)

update_python_with_ai(
    name = "sandbox_asm",
    module_deps = [':sandbox_file_editor_impl', ':sandbox_file_reader_impl', ':sandbox_guide_delivery_impl', ':sandbox_impl', ':sandbox_run_control_impl', ':template_format_impl', ':tool_provider_impl'],
)

