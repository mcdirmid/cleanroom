    module_deps = ['//update_with_ai/parts/agent:agent_file_alias', ':tool_provider'],
)

update_python_with_ai(
    name = "sandbox_file_editor_impl",
    module_deps = ['//update_with_ai/parts/agent:agent_config', '//update_with_ai/parts/agent:agent_file_alias', '//update_with_ai/parts/core:filesystem_ext', '//update_with_ai/parts/agent:agent_node_config', ':sandbox_file_editor', ':template_format', ':tool_provider'],
)

update_python_with_ai(
    name = "sandbox_file_reader",
