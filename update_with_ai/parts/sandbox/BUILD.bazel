update_python_with_ai(
    name = "sandbox_run_control_impl",
    module_deps = ['//update_with_ai/parts/dag:dag_storage', '//update_with_ai/parts/agent:agent_file_alias', '//update_with_ai/parts/agent:agent_node_config', ':sandbox_file_editor', ':sandbox_guide_delivery', ':sandbox_run_control', ':template_format', ':tool_provider'],
)

update_python_with_ai(
    name = "template_format",
    module_deps = [],
)

update_python_with_ai(
    name = "template_format_impl",
    module_deps = ['//update_with_ai/parts/core:commonmark_ext', ':template_format'],
)

