update_python_with_ai(
    name = "sandbox_run_control",
    module_deps = ['//update_with_ai/parts/dag:dag_storage', '//update_with_ai/parts/agent:agent_file_alias', '//update_with_ai/parts/agent:agent_node_config', ':sandbox_file_editor', ':sandbox_guide_delivery', ':tool_provider'],
