# update_with_ai/parts/openai/BUILD.bazel

load("//update_python_with_ai/support/lib:update_python_with_ai.bzl", "update_python_with_ai")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "high_specs",
    srcs = glob(["high/*.md"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "grounding_specs",
    srcs = glob(["grounding/*.pyi"]),
    visibility = ["//visibility:public"],
)

update_python_with_ai(
    name = "openai_config",
    module_deps = [],
)

update_python_with_ai(
    name = "openai_conversation_impl",
    module_deps = ['//update_with_ai/parts/agent:agent_conversation', ':openai_ext', '//update_with_ai/parts/sandbox:tool_provider'],
)

update_python_with_ai(
    name = "openai_driver_impl",
    module_deps = ['//update_with_ai/parts/agent:agent_config', '//update_with_ai/parts/agent:agent_conversation', '//update_with_ai/parts/agent:agent_driver', '//update_with_ai/parts/agent:agent_loop_guard', ':openai_config', ':openai_ext', '//update_with_ai/parts/core:runner_logger', '//update_with_ai/parts/sandbox:tool_provider'],
)

update_python_with_ai(
    name = "openai_ext",
    module_deps = [],
)
