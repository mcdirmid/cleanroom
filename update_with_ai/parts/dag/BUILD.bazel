# update_with_ai/parts/dag/BUILD.bazel

load("//update_python_with_ai/support/lib:update_python_with_ai.bzl", "update_python_with_ai")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "high_specs",
    srcs = glob(["high/*.md"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "grounding_specs",
    srcs = glob(["grounding/*.pyi"]),
    visibility = ["//visibility:public"],
)

update_python_with_ai(
    name = "dag_asm",
    module_deps = [':dag_cleaner_impl'],
)

update_python_with_ai(
    name = "dag_cleaner",
    module_deps = [':dag_node_cleaner', ':dag_storage'],
)

update_python_with_ai(
    name = "dag_cleaner_impl",
    module_deps = [':dag_cleaner', ':dag_config', ':dag_node_cleaner', ':dag_storage'],
)

update_python_with_ai(
    name = "dag_config",
    module_deps = [],
)

update_python_with_ai(
    name = "dag_node_cleaner",
    module_deps = [':dag_storage'],
)

update_python_with_ai(
    name = "dag_runner",
    module_deps = [':dag_storage'],
)

update_python_with_ai(
    name = "dag_storage",
    module_deps = [],
)
