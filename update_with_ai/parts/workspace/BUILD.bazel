        "//update_with_ai/parts/agent:agent_session",
        "//update_with_ai/parts/control:src_metadata",
        ":workspace_registry",
        ":workspace_sync",
    ],
)

update_python_with_ai(
    name = "workspace_work",
    module_deps = [
        "//update_with_ai/parts/agent:agent_session",
        "//update_with_ai/parts/control:control_work_scheduler",
        "//update_with_ai/parts/control:src_metadata",
        "//update_with_ai/parts/dag:dag_storage",
        ":workspace_registry",
    ],
)

update_python_with_ai(
    name = "workspace_work_impl",
    module_deps = [
        "//update_with_ai/parts/agent:agent_session",
        "//update_with_ai/parts/control:control_work_scheduler",
        "//update_with_ai/parts/control:src_metadata",
        "//update_with_ai/parts/dag:dag_storage",
