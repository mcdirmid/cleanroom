)

update_python_with_ai(
    name = "workspace_tool_impl",
    module_deps = [
        "//update_with_ai/parts/agent:agent_session",
        "//update_with_ai/parts/control:control_attribution",
        "//update_with_ai/parts/control:control_submit",
        "//update_with_ai/parts/tools:tool_coverage",
        ":workspace_provision",
        ":workspace_registry",
        ":workspace_sync",
        ":workspace_tool",
        ":workspace_work",
    ],
)


update_python_with_ai(
    name = "workspace_asm",
    module_deps = [
        "//update_with_ai/parts/agent:agent_session",
