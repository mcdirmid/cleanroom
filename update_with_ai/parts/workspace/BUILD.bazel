# update_with_ai/parts/workspace/BUILD.bazel

load("//update_python_with_ai/support/lib:update_python_with_ai.bzl", "update_python_with_ai")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "high_specs",
    srcs = glob(["high/*.md"], allow_empty = True),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "grounding_specs",
    srcs = glob(["grounding/*.gt", "grounding/*.py", "grounding/*.pyi", "low/*.pyi"], allow_empty = True),
    visibility = ["//visibility:public"],
)

update_python_with_ai(
    name = "workspace_registry",
    module_deps = [
        "//update_with_ai/parts/agent:agent_session",
    ],
)

update_python_with_ai(
    name = "workspace_registry_impl",
    module_deps = [
        "//update_with_ai/parts/agent:agent_session",
        "//update_with_ai/parts/bazel:bazel_manifest_ext",
        ":workspace_registry",
    ],
)

update_python_with_ai(
    name = "workspace_provision",
    module_deps = [
        "//update_with_ai/parts/agent:agent_session",
        ":workspace_registry",
    ],
)

update_python_with_ai(
    name = "workspace_provision_impl",
    module_deps = [
        "//update_with_ai/parts/agent:agent_session",
        ":workspace_provision",
        ":workspace_registry",
    ],
)

update_python_with_ai(
    name = "workspace_sync",
    module_deps = [
        "//update_with_ai/parts/agent:agent_session",
        "//update_with_ai/parts/control:src_metadata",
