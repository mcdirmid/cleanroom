# update_with_ai/parts/systems/BUILD.bazel

load("//update_python_with_ai/support/lib:update_python_with_ai.bzl", "update_python_with_ai")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "high_specs",
    srcs = glob(["high/*.md"], allow_empty = True),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "grounding_specs",
    srcs = glob(["grounding/*.gt", "grounding/*.py", "grounding/*.pyi", "low/*.pyi"], allow_empty = True),
    visibility = ["//visibility:public"],
)

update_python_with_ai(
    name = "bazel_openai_loop_asm",
    module_deps = [
        '//update_with_ai/parts/bazel:bazel_asm',
        '//update_with_ai/parts/bazel:bazel_loop_impl',
        '//update_with_ai/parts/bazel:bazel_openai_config_impl',
        '//update_with_ai/parts/core:runner_logger_impl',
        '//update_with_ai/parts/dag:dag_asm',
        '//update_with_ai/parts/loop:loop_asm',
        '//update_with_ai/parts/sandbox:sandbox_asm',
    ],
)

update_python_with_ai(
    name = "cleanroom_asm",
    module_deps = [
        ':bazel_openai_loop_asm',
        '//update_with_ai/parts/control:control_asm',
        '//update_with_ai/parts/core:file_paths_impl',
        '//update_with_ai/parts/tools:tools_asm',
        '//update_with_ai/parts/workspace:workspace_asm',
        '//update_with_ai/parts/workspace:workspace_tool_impl',
    ],
)

update_python_with_ai(
    name = "uv_openai_loop_asm",
    module_deps = [
        '//update_with_ai/parts/uv:uv_model_config_impl',
        '//update_with_ai/parts/core:runner_logger_impl',
        '//update_with_ai/parts/dag:dag_asm',
        '//update_with_ai/parts/loop:loop_asm',
        '//update_with_ai/parts/sandbox:sandbox_asm',
        '//update_with_ai/parts/uv:uv_asm',
        '//update_with_ai/parts/uv:uv_loop_impl',
    ],
)

update_python_with_ai(
    name = "uv_cleanroom_asm",
    module_deps = [
        ':uv_openai_loop_asm',
        '//update_with_ai/parts/control:control_asm',
        '//update_with_ai/parts/core:file_paths_impl',
        '//update_with_ai/parts/tools:tools_asm',
        '//update_with_ai/parts/workspace:workspace_asm',
        '//update_with_ai/parts/workspace:workspace_tool_impl',
    ],
)
