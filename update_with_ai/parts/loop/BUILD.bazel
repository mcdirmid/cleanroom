# update_with_ai/parts/loop/BUILD.bazel

load("//update_python_with_ai/support/lib:update_python_with_ai.bzl", "update_python_with_ai")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "high_specs",
    srcs = glob(["high/*.md"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "grounding_specs",
    srcs = glob(["grounding/*.pyi"]),
    visibility = ["//visibility:public"],
)

update_python_with_ai(
    name = "loop",
    module_deps = ['//update_with_ai/parts/dag:dag_storage'],
)

update_python_with_ai(
    name = "loop_asm",
    module_deps = [':loop_cleaner_impl', ':loop_guard_impl', ':loop_node_cleaner_impl', '//update_with_ai/parts/openai:openai_conversation_impl', '//update_with_ai/parts/openai:openai_driver_impl'],
)

update_python_with_ai(
    name = "loop_cleaner",
    module_deps = [':loop_node_cleaner', '//update_with_ai/parts/dag:dag_storage'],
)

update_python_with_ai(
    name = "loop_cleaner_impl",
    module_deps = [':loop_cleaner', ':loop_node_cleaner', '//update_with_ai/parts/dag:dag_storage', '//update_with_ai/parts/dag:dag_subgraph'],
)

update_python_with_ai(
    name = "loop_conversation",
    module_deps = ['//update_with_ai/parts/sandbox:tool_provider'],
)

update_python_with_ai(
    name = "loop_driver",
    module_deps = [':loop_conversation', ':loop_guard', '//update_with_ai/parts/agent:agent_config', '//update_with_ai/parts/core:runner_logger', '//update_with_ai/parts/sandbox:tool_provider'],
)

update_python_with_ai(
    name = "loop_guard",
    module_deps = ['//update_with_ai/parts/sandbox:tool_provider'],
)

update_python_with_ai(
    name = "loop_guard_impl",
    module_deps = ['//update_with_ai/parts/agent:agent_session', ':loop_guard', '//update_with_ai/parts/sandbox:tool_provider'],
)

update_python_with_ai(
    name = "loop_node_cleaner",
    module_deps = ['//update_with_ai/parts/dag:dag_storage'],
)

update_python_with_ai(
    name = "loop_node_cleaner_impl",
    module_deps = ['//update_with_ai/parts/agent:agent_node_config', '//update_with_ai/parts/agent:agent_session', '//update_with_ai/parts/agent:agent_storage', '//update_with_ai/parts/dag:dag_storage', '//update_with_ai/parts/sandbox:sandbox', '//update_with_ai/parts/sandbox:template_format', ':loop_conversation', ':loop_driver', ':loop_node_cleaner'],
)
