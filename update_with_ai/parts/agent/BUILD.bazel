# update_with_ai/parts/agent/BUILD.bazel

load("//update_python_with_ai/support/lib:update_python_with_ai.bzl", "update_python_with_ai")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "high_specs",
    srcs = glob(["high/*.md"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "grounding_specs",
    srcs = glob(["grounding/*.pyi"]),
    visibility = ["//visibility:public"],
)

update_python_with_ai(
    name = "agent_config",
    module_deps = [],
)

update_python_with_ai(
    name = "agent_file_alias",
    module_deps = ['//update_with_ai/parts/dag:dag_storage', '//update_with_ai/parts/core:file_paths', '//update_with_ai/parts/sandbox:tool_provider'],
)

update_python_with_ai(
    name = "agent_node_config",
    module_deps = [':agent_config', ':agent_file_alias', '//update_with_ai/parts/dag:dag_storage'],
)

update_python_with_ai(
    name = "agent_session",
    module_deps = [],
)

update_python_with_ai(
    name = "agent_storage",
    module_deps = ['//update_with_ai/parts/dag:dag_storage'],
)
