# specs/BUILD.bazel
# High-level specification files (specs/high), linted by //update_python_with_ai/bin:hls_lint_test.
# Low-level specification files (specs/low), linted by //update_python_with_ai/bin:lls_lint_test.

filegroup(
    name = "high_specs",
    srcs = glob(["high/*.md"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "low_specs",
    srcs = glob(["low/*.md"]),
    visibility = ["//visibility:public"],
)
