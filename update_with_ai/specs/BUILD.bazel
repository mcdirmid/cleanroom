# update_with_ai/specs/BUILD.bazel
#
# High-level specification files (specs/high), linted by //update_python_with_ai/bin:hls_lint_test.
# Low-level specification files (specs/low), linted by //update_python_with_ai/bin:lls_lint_test.
#
# High-level specification nodes for update_with_ai. Each update_python_with_ai
# call creates the node's *_high (and *_low) update_with_ai targets plus a
# *_high_lint test target; a dependent node passes the labels of its spec deps
# (not raw file labels), so its manifest deps and lint coverage include the
# full transitive closure.
#
# module_deps mirrors each spec's dependencies: the high-level front matter
# (the fulfills target, the `imports:` specs, and every `terms (from X)`
# owner) plus the low-level spec's dependency-comment entries (which the
# *_low_lint test verifies are covered). Label strings (rather than bound
# handles) are used so dependency order is resolved by Bazel; the spec graph
# must be acyclic, since node deps are hard build edges.

load("//update_python_with_ai:update_python_with_ai.bzl", "update_python_with_ai")
load("//update_with_ai/lib:update_with_ai.bzl", "update_with_ai")

filegroup(
    name = "high_specs",
    srcs = glob(["high/*.md"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "low_specs",
    srcs = glob(["low/*.md"]),
    visibility = ["//visibility:public"],
)

# External dependency docs (not low-level specs): nameable as dependency-
# comment entries (e.g. `- openai_api.md`) and in runfiles for the lints.
filegroup(
    name = "external_specs",
    srcs = glob(["external/*.md"]),
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# Dependency-free specs
# ---------------------------------------------------------------------------

update_python_with_ai(
    name = "dag_storage",
    module_deps = [],
)

update_python_with_ai(
    name = "tool_provider",
    module_deps = [],
)

# ---------------------------------------------------------------------------
# dag family
# ---------------------------------------------------------------------------

update_python_with_ai(
    name = "dag_clean_logic",
    module_deps = ["dag_storage", "tool_provider"],
)

update_python_with_ai(
    name = "dag_cleaner",
    module_deps = ["dag_storage", "dag_clean_logic"],
)

update_python_with_ai(
    name = "dag_cleaner_impl",
    module_deps = ["dag_cleaner", "dag_storage", "dag_clean_logic"],
)

# ---------------------------------------------------------------------------
# file_view / guide_delivery / run_control: the file, delivery, and control
# machinery. All build on tool_provider; run_control also builds on the dag
# specs and agent_loop, and the implementations fulfill their interfaces.
# ---------------------------------------------------------------------------

update_python_with_ai(
    name = "file_view",
    module_deps = ["tool_provider"],
)

update_python_with_ai(
    name = "file_view_impl",
    module_deps = ["file_view", "tool_provider"],
)

update_python_with_ai(
    name = "guide_delivery",
    module_deps = ["tool_provider"],
)

update_python_with_ai(
    name = "guide_delivery_impl",
    module_deps = ["guide_delivery", "tool_provider"],
)

update_python_with_ai(
    name = "run_control",
    module_deps = ["tool_provider", "dag_clean_logic", "dag_storage", "file_view", "guide_delivery"],
)

update_python_with_ai(
    name = "run_control_impl",
    module_deps = ["run_control", "tool_provider", "dag_clean_logic", "dag_storage", "file_view", "guide_delivery"],
)

# ---------------------------------------------------------------------------
# sandbox / agent_loop (sandbox imports agent_loop's run term and composes
# file_view, guide_delivery, and run_control; agent_loop builds on
# tool_provider only)
# ---------------------------------------------------------------------------

update_python_with_ai(
    name = "agent_loop",
    module_deps = ["tool_provider"],
)

update_python_with_ai(
    name = "agent_loop_config",
    module_deps = ["agent_loop"],
)

update_python_with_ai(
    name = "agent_loop_impl",
    module_deps = ["agent_loop", "agent_loop_config", "tool_provider"],
    external_deps = [":openai_api"],
)

# External dependency doc node: brings a non-spec file (the OpenAI API usage
# doc) into the system as a readable dependency. It has no guide, so the
# *_clean wrapper cannot run until a guide is added later; the node itself
# (prompt/manifest) is valid.
update_with_ai(
    name = "openai_api",
    prompt = "Maintain specs/external/openai_api.md (the OpenAI API usage doc for agent prompt calls); _clean is unavailable until a guide is added.",
    src = "external/openai_api.md",
)

update_python_with_ai(
    name = "sandbox",
    module_deps = ["tool_provider", "dag_storage", "dag_clean_logic", "file_view", "guide_delivery", "run_control"],
)

update_python_with_ai(
    name = "sandbox_impl",
    module_deps = ["sandbox", "file_view", "guide_delivery", "run_control"],
)

# ---------------------------------------------------------------------------
# bazel_* family and remaining implementations
# ---------------------------------------------------------------------------

update_python_with_ai(
    name = "build_node_loader",
    module_deps = ["tool_provider", "file_view", "guide_delivery"],
)

update_python_with_ai(
    name = "build_agent_config",
    module_deps = ["agent_loop_config"],
)

update_python_with_ai(
    name = "build_graph_storage",
    module_deps = ["dag_storage", "sandbox", "run_control", "file_view", "guide_delivery"],
)

update_python_with_ai(
    name = "build_node_loader_impl",
    module_deps = ["build_node_loader", "tool_provider", "agent_loop"],
)

update_python_with_ai(
    name = "build_agent_config_impl",
    module_deps = ["build_agent_config", "agent_loop_config"],
)

update_python_with_ai(
    name = "build_graph_storage_impl",
    module_deps = ["build_graph_storage", "dag_storage", "sandbox", "run_control", "file_view", "guide_delivery", "build_node_loader"],
)

update_python_with_ai(
    name = "agent_node_clean_logic_impl",
    module_deps = ["dag_clean_logic", "build_graph_storage", "dag_storage", "agent_loop", "agent_loop_config", "sandbox", "run_control", "file_view", "guide_delivery", "tool_provider"],
)

update_python_with_ai(
    name = "build_runner",
    module_deps = ["dag_cleaner", "dag_storage", "dag_clean_logic", "build_agent_config", "sandbox", "guide_delivery", "run_control", "build_node_loader"],
)

update_python_with_ai(
    name = "build_runner_impl",
    module_deps = ["build_runner", "dag_storage", "dag_cleaner", "dag_clean_logic", "build_graph_storage", "agent_loop", "build_agent_config"],
)

update_python_with_ai(
    name = "sandbox_asm",
    module_deps = ["sandbox_impl", "file_view_impl", "guide_delivery_impl", "run_control_impl", "sandbox", "run_control"],
)

update_python_with_ai(
    name = "dag_cleaner_asm",
    module_deps = ["dag_cleaner_impl", "dag_cleaner", "dag_clean_logic", "build_graph_storage"],
)

update_python_with_ai(
    name = "agent_node_clean_logic_asm",
    module_deps = ["agent_node_clean_logic_impl", "agent_loop_impl", "build_agent_config_impl", "sandbox_asm", "dag_clean_logic", "build_graph_storage", "build_agent_config", "agent_loop"],
)

update_python_with_ai(
    name = "build_asm",
    module_deps = ["build_runner_impl", "build_graph_storage_impl", "agent_node_clean_logic_asm", "dag_cleaner_asm", "build_runner"],
)

